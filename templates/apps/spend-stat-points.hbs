<div class="carl-spend-stat-points-body">
  <p class="carl-hint">
    {{#if isMob}}{{localize "CARLRPG.SpendStatPoints.HintMob"}}{{else}}{{localize "CARLRPG.SpendStatPoints.Hint"}}{{/if}}
  </p>
  {{#if isMob}}
  <p class="carl-hint carl-spend-stat-points-formula">
    {{localize "CARLRPG.SpendStatPoints.MobFormula" level=level statPointsPerLevel=statPointsPerLevel statPointsBase=statPointsBase}}
  </p>
  {{/if}}
  <div class="carl-spend-stat-points-banked">
    {{#if isMob}}{{localize "CARLRPG.Actor.StatPointsRemaining"}}{{else}}{{localize "CARLRPG.Actor.BankedStatPoints"}}{{/if}}:
    <strong>{{remainingPoints}}</strong>
  </div>
  <div class="carl-spend-stat-points-grid">
    <div class="carl-spend-stat-points-row carl-spend-stat-points-header">
      <span></span>
      <span>{{localize "CARLRPG.SpendStatPoints.Stat"}}</span>
      <span>{{localize "CARLRPG.SpendStatPoints.Unmodified"}}</span>
      <span>{{localize "CARLRPG.SpendStatPoints.Modified"}}</span>
    </div>
    {{#each stats as |stat|}}
    <div class="carl-spend-stat-points-row">
      <div class="carl-spend-stat-points-buttons">
        <button type="button" data-action="decrementStat" data-key="{{stat.key}}"
          {{#if stat.atInitial}}disabled{{/if}} title="{{localize 'CARLRPG.SpendStatPoints.Decrement'}}">
          <i class="fas fa-minus"></i>
        </button>
        <button type="button" data-action="incrementStat" data-key="{{stat.key}}"
          {{#if (lte remainingPoints 0)}}disabled{{/if}} title="{{localize 'CARLRPG.SpendStatPoints.Increment'}}">
          <i class="fas fa-plus"></i>
        </button>
      </div>
      <span class="carl-spend-stat-points-label">{{stat.label}}</span>
      <span class="carl-spend-stat-points-value">{{stat.value}}</span>
      <span class="carl-spend-stat-points-value">{{stat.effective}}</span>
    </div>
    {{/each}}
  </div>
</div>
