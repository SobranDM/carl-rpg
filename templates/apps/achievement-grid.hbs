{{!-- The GM's Achievements window (module/apps/achievement-grid.mjs):
      crawlers across, achievements down - alphabetical, a category's grouped
      under its name, Bronze to Celestial. A dimmed icon: click to award; a
      lit one: awarded (a check once its box is opened) - click to take it
      back. Right-click either: that crawler's loot box. An achievement's name opens its editor
      in a column beside the list; each column scrolls on its own. The
      search box filters the list as it's typed in (achievement-grid.mjs
      #applySearch), by name or category. --}}
<div class="carl-grid">
  <div class="carl-grid-list">
  <div class="carl-grid-controls">
    <label class="checkbox">
      <input type="checkbox" data-action="toggleOffline" {{#if showOffline}}checked{{/if}} />
      {{localize "CARLRPG.Achievement.Grid.ShowOffline"}}
    </label>
    <input type="search" class="carl-grid-search" value="{{search}}" aria-label="{{localize 'CARLRPG.Achievement.Grid.Search'}}"
      placeholder="{{localize 'CARLRPG.Achievement.Grid.Search'}}" />
    <button type="button" data-action="newAchievement"><i class="fas fa-plus"></i> {{localize "CARLRPG.Achievement.Grid.New"}}</button>
  </div>

  {{#if sections.length}}
  {{#unless columns.length}}<p class="carl-hint">{{localize "CARLRPG.Achievement.Grid.NoCrawlers"}}</p>{{/unless}}
  <div class="carl-grid-scroll">
    <table class="carl-grid-table">
      <thead>
        <tr>
          <th></th>
          {{#each columns as |c|}}
          <th class="carl-grid-crawler"><img src="{{c.img}}" alt="" /><span>{{c.name}}</span></th>
          {{/each}}
        </tr>
      </thead>
      {{!-- A category is its own section: its name, then its achievements
            Bronze to Celestial, with a line above and below. Clicking its
            name folds it to that line, with how many it holds (its rows are
            hidden, not left out: a search shows them). --}}
      {{#each sections as |section|}}
      <tbody{{#if section.category}} class="carl-grid-group{{#if section.collapsed}} carl-grid-collapsed{{/if}}"{{/if}}>
        {{#if section.category}}
        <tr class="carl-grid-group-head"><th colspan="{{@root.span}}">
          <a data-action="toggleCategory" data-key="{{section.key}}" aria-expanded="{{#if section.collapsed}}false{{else}}true{{/if}}">
            <i class="fas fa-chevron-{{#if section.collapsed}}right{{else}}down{{/if}}"></i> {{section.category}}
            <span class="carl-grid-group-count">({{section.count}})</span>
          </a>
        </th></tr>
        {{/if}}
        {{#each section.rows as |row|}}
        <tr class="carl-grid-row{{#if row.editing}} carl-grid-editing{{/if}}" data-uuid="{{row.uuid}}" data-search="{{row.search}}">
          <th class="carl-grid-achievement"{{itemTooltip row.tooltip}}>
            <a data-action="editAchievement">{{row.name}}</a>
          </th>
          {{#each row.cells as |cell|}}
          <td class="carl-grid-cell carl-grid-{{cell.state}}" data-action="award" data-actor-id="{{cell.actorId}}"
            {{#unless (eq cell.state "none")}}data-state="{{cell.state}}"{{/unless}} data-tooltip-text="{{cell.tooltip}}">
            <img src="{{row.img}}" alt="" />
            {{#if (eq cell.state "rewarded")}}<i class="fas fa-check carl-grid-check"></i>{{/if}}
          </td>
          {{/each}}
        </tr>
        {{/each}}
      </tbody>
      {{/each}}
    </table>
    <p class="carl-hint carl-grid-no-match" hidden>{{localize "CARLRPG.Achievement.Grid.NoMatches"}}</p>
  </div>
  {{else}}
  <p class="carl-hint">{{localize "CARLRPG.Achievement.Grid.NoAchievements"}}</p>
  {{/if}}
  </div>

  {{#if editor}}
  {{!-- The editor: every field saves as it changes. --}}
  <section class="carl-achievement-editor" data-uuid="{{editor.uuid}}">
    <header class="carl-box-head">
      <img class="carl-box-art" src="{{editor.img}}" alt="" />
      <div class="carl-box-title">
        <input type="text" name="name" value="{{editor.name}}" placeholder="{{localize 'Name'}}" />
        <label class="carl-sheet-line">
          <span>{{localize "CARLRPG.Achievement.Grade"}}</span>
          <select name="system.grade">{{selectOptions editor.gradeChoices selected=editor.system.grade localize=true}}</select>
        </label>
      </div>
    </header>
    <label class="carl-sheet-line">
      <span>{{localize "CARLRPG.Achievement.Reward"}}</span>
      <input type="text" name="system.reward" value="{{editor.system.reward}}" placeholder="{{localize 'CARLRPG.Achievement.RewardPlaceholder'}}" />
    </label>
    <label class="carl-sheet-line" data-tooltip-text="{{localize 'CARLRPG.Achievement.CategoryHint'}}">
      <span>{{localize "CARLRPG.Achievement.Category"}}</span>
      <input type="text" name="system.category" value="{{editor.system.category}}" list="carl-achievement-categories"
        placeholder="{{localize 'CARLRPG.Achievement.CategoryPlaceholder'}}" />
      <datalist id="carl-achievement-categories">{{#each editor.categories}}<option value="{{this}}"></option>{{/each}}</datalist>
    </label>
    <label class="carl-sheet-line" data-tooltip-text="{{localize 'CARLRPG.Achievement.LootBoxHint'}}">
      <span>{{localize "CARLRPG.Achievement.LootBox"}}</span>
      <input type="checkbox" name="system.lootBox" {{checked editor.system.lootBox}} />
    </label>
    <prose-mirror toggled value="{{editor.system.description}}" data-document-uuid="{{editor.uuid}}">
      {{{editor.descriptionHTML}}}
    </prose-mirror>
    {{#if editor.boxes}}
    {{!-- Each crawler's loot box for it: prepared, or rolled when opened. --}}
    <fieldset class="carl-achievement-boxes">
      <legend>{{localize "CARLRPG.Achievement.Grid.Box.Legend"}}</legend>
      {{#each editor.boxes as |b|}}
      <div class="carl-achievement-box-row" data-actor-id="{{b.actorId}}">
        <span class="carl-achievement-box-name">{{b.name}}</span>
        <span class="carl-hint">{{localize b.label}}</span>
        {{#if b.canPrepare}}
        <a class="item-control" data-action="prepareFor" data-tooltip-text="{{localize 'CARLRPG.Achievement.Grid.Box.Prepare'}}"><i class="fas fa-hammer"></i></a>
        {{#if b.prepared}}
        <a class="item-control" data-action="clearFor" data-tooltip-text="{{localize 'CARLRPG.Box.Randomize'}}"><i class="fas fa-dice"></i></a>
        {{/if}}
        {{/if}}
      </div>
      {{else}}
      <p class="carl-hint">{{localize "CARLRPG.Achievement.Grid.NoCrawlers"}}</p>
      {{/each}}
    </fieldset>
    {{/if}}
    <footer class="carl-box-buttons">
      <button type="button" data-action="closeEditor"><i class="fas fa-check"></i> {{localize "CARLRPG.Achievement.Grid.Done"}}</button>
      <button type="button" data-action="deleteAchievement"><i class="fas fa-trash"></i> {{localize "CARLRPG.Achievement.Grid.Delete"}}</button>
    </footer>
  </section>
  {{/if}}
</div>
