<div class="carl-toolbox-body">
  <fieldset class="carl-toolbox-section">
    <legend>{{localize "CARLRPG.Toolbox.RealWorldTimer"}}</legend>
    <div class="carl-toolbox-row">
      <button type="button" data-action="toggleTimer">
        <i class="fas {{#if timerRunning}}fa-stop{{else}}fa-play{{/if}}"></i>
        {{#if timerRunning}}{{localize "CARLRPG.Toolbox.StopTimer"}}{{else}}{{localize "CARLRPG.Toolbox.StartTimer"}}{{/if}}
      </button>
      <span data-el="elapsed" class="carl-toolbox-elapsed">{{elapsedLabel}}</span>
    </div>
    <div class="carl-toolbox-row">
      <button type="button" data-action="resolveTwoHourTick" data-pulse-target
        class="{{#if thresholdReached}}pulse{{/if}}">
        <i class="fas fa-dice-d20"></i> {{localize "CARLRPG.Toolbox.ResolveTwoHour"}}
      </button>
    </div>
  </fieldset>

  <fieldset class="carl-toolbox-section">
    <legend>{{localize "CARLRPG.Toolbox.FloorProgress"}}</legend>
    <div class="carl-toolbox-row carl-toolbox-floor-row">
      <button type="button" data-action="floorDecrement" data-tooltip-text="{{localize 'CARLRPG.Toolbox.FloorDecrement'}}">
        <i class="fas fa-minus"></i>
      </button>
      <span class="carl-toolbox-floor">{{localize "CARLRPG.Actor.Floor"}} {{floor}}</span>
      <button type="button" data-action="floorIncrement" data-tooltip-text="{{localize 'CARLRPG.Toolbox.FloorIncrement'}}">
        <i class="fas fa-plus"></i>
      </button>
    </div>
    <div class="carl-toolbox-row">
      <button type="button" data-action="endFloor" data-tooltip-text="{{localize 'CARLRPG.Toolbox.EndFloorHint'}}">
        <i class="fas fa-stairs"></i> {{localize "CARLRPG.Toolbox.EndFloor"}}
      </button>
      <button type="button" data-action="bossKilled" data-tooltip-text="{{localize 'CARLRPG.Toolbox.BossKilledHint'}}">
        <i class="fas fa-skull"></i> {{localize "CARLRPG.Toolbox.BossKilled"}}
      </button>
    </div>
  </fieldset>

  <fieldset class="carl-toolbox-section">
    <legend>{{localize "CARLRPG.Toolbox.InWorldRest"}}</legend>
    <div class="carl-toolbox-row">
      <button type="button" data-action="rest"><i class="fas fa-bed"></i> {{localize "CARLRPG.Toolbox.Rest.Button"}}</button>
      <button type="button" data-action="mend" data-tooltip-text="{{localize 'CARLRPG.Toolbox.MendHint'}}">
        <i class="fas fa-bandage"></i> {{localize "CARLRPG.Toolbox.Mend"}}
      </button>
    </div>
  </fieldset>

  <fieldset class="carl-toolbox-section">
    <legend>{{localize "CARLRPG.Toolbox.Other"}}</legend>
    <div class="carl-toolbox-row">
      <button type="button" data-action="grind"><i class="fas fa-dumbbell"></i> {{localize "CARLRPG.Toolbox.Grind"}}</button>
      <button type="button" data-action="rollLoot"><i class="fas fa-gem"></i> {{localize "CARLRPG.Toolbox.RollLoot"}}</button>
      <button type="button" data-action="giveBox" data-tooltip-text="{{localize 'CARLRPG.Box.GiveHint'}}"><i class="fas fa-box"></i> {{localize "CARLRPG.Box.Give"}}</button>
    </div>
    <div class="carl-toolbox-row">
      <button type="button" data-action="partyCheck" data-tooltip-text="{{localize 'CARLRPG.PartyCheck.ButtonHint'}}">
        <i class="fas fa-people-group"></i> {{localize "CARLRPG.PartyCheck.Button"}}</button>
      <button type="button" data-action="newScene" data-tooltip-text="{{localize 'CARLRPG.Toolbox.NewSceneHint'}}">
        <i class="fas fa-clapperboard"></i> {{localize "CARLRPG.Toolbox.NewScene"}}</button>
    </div>
  </fieldset>
</div>
