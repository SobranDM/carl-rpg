<div class="carl-dialog-body">
  {{#if showRollMode}}
  <div class="form-group">
    <label>{{localize "CARLRPG.Dialog.RollMode"}}</label>
    <div class="form-fields">
      <label><input type="radio" name="advantage" value="normal" {{#unless defaultAdvantage}}checked{{/unless}} /> {{localize "CARLRPG.Dialog.Normal"}}</label>
      <label><input type="radio" name="advantage" value="advantage" {{#if (eq defaultAdvantage "advantage")}}checked{{/if}} /> {{localize "CARLRPG.Dialog.Advantage"}}</label>
      <label><input type="radio" name="advantage" value="disadvantage" /> {{localize "CARLRPG.Dialog.Disadvantage"}}</label>
    </div>
    {{#if defaultAdvantage}}
    <p class="carl-dialog-hint">{{localize "CARLRPG.Dialog.AdvantageAutoApplied"}}</p>
    {{/if}}
  </div>
  {{/if}}
  {{#if showDifficulty}}
  {{#if difficultyPresets.length}}
  {{!-- p.59's Difficulty formulas at the current Floor; picking one fills the
        number below (module/dice/roll-prompt.mjs wires the change). --}}
  <div class="form-group">
    <label>{{localize "CARLRPG.Dialog.DifficultyPreset"}}</label>
    <div class="form-fields">
      <select name="difficultyPreset" data-carl-difficulty-preset>
        {{#each difficultyPresets as |preset|}}
        <option value="{{preset.key}}" data-value="{{preset.value}}" {{#if preset.selected}}selected{{/if}}>{{preset.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{#if difficultyLabel}}{{difficultyLabel}}{{else}}{{localize "CARLRPG.Dialog.Difficulty"}}{{/if}}</label>
    <div class="form-fields">
      <input type="number" name="difficulty" value="{{difficulty}}" placeholder="{{localize 'CARLRPG.Dialog.DifficultyPlaceholder'}}" />
    </div>
  </div>
  {{/if}}
  {{#if areaTargets.length}}
  {{!-- Area Attack (p.83): one roll, damage to everyone in the area; Splash
        targets take half. Pre-ticked when the Skill/Spell/Attack reads as an
        area (module/helpers/area.mjs). --}}
  <div class="form-group">
    <label>{{localize "CARLRPG.Dialog.AreaAttack"}}</label>
    <div class="form-fields">
      <label><input type="checkbox" name="isArea" data-carl-area-toggle {{#if isArea}}checked{{/if}} /> {{localize "CARLRPG.Dialog.AreaAttackHint"}}</label>
    </div>
  </div>
  <div class="form-group carl-splash-targets" {{#unless isArea}}style="display: none"{{/unless}}>
    <label>{{localize "CARLRPG.Dialog.SplashTargets"}}</label>
    <div class="form-fields carl-dialog-checklist">
      {{#each areaTargets as |t index|}}
      <label><input type="checkbox" name="{{concat 'splash.' index}}" /> {{t.name}}</label>
      {{/each}}
    </div>
  </div>
  {{/if}}
  {{#if damageEffectChoices.length}}
  <div class="form-group">
    <label>{{localize "CARLRPG.Dialog.DamageEffect"}}</label>
    <div class="form-fields">
      <select name="damageEffectId">
        <option value=""></option>
        {{#each damageEffectChoices as |de|}}
        <option value="{{de.id}}">{{de.name}} ({{localize "CARLRPG.Roll.Rank"}} {{de.rank}})</option>
        {{/each}}
      </select>
    </div>
  </div>
  {{/if}}
  {{#if manaCostChoices.length}}
  <div class="form-group carl-dialog-mana-cost">
    <label>{{localize "CARLRPG.Spell.ManaCost"}}</label>
    <div class="form-fields carl-dialog-mana-cost-list">
      {{#each manaCostChoices as |mc index|}}
      <label class="carl-dialog-mana-cost-option">
        <input type="radio" name="manaCostChoice" value="{{index}}" {{#if mc.isBase}}checked{{/if}} />
        {{mc.manaCost}} {{localize "CARLRPG.Actor.Mana"}}{{#unless mc.isBase}} - {{mc.description}}{{/unless}}
      </label>
      {{/each}}
    </div>
  </div>
  {{/if}}
  {{!-- Active Debuffs that change this roll (module/helpers/debuff-effects.mjs),
        pre-ticked per row.defaultOn - untick one the fiction says doesn't
        apply (e.g. Blinded on a Check that doesn't need sight). --}}
  {{#if debuffRows.length}}
  <div class="form-group carl-dialog-conditions carl-dialog-debuffs">
    <label>{{localize "CARLRPG.Dialog.Debuffs"}}</label>
    <div class="form-fields carl-dialog-conditions-list">
      {{#each debuffRows as |row|}}
      <label class="carl-dialog-condition">
        <input type="checkbox" name="debuffs.{{row.id}}" {{#if row.defaultOn}}checked{{/if}} />
        {{row.label}} <span class="carl-dialog-condition-source">({{row.detail}})</span>
      </label>
      {{/each}}
    </div>
  </div>
  {{/if}}
  {{#if conditions.length}}
  <div class="form-group carl-dialog-conditions">
    <label>{{localize "CARLRPG.Dialog.OptionalModifiers"}}</label>
    <div class="form-fields carl-dialog-conditions-list">
      {{#each conditions as |cm|}}
      {{#each cm.conditions as |cond|}}
      <label class="carl-dialog-condition">
        <input type="checkbox" name="conditions.{{cm.id}}.{{cond.id}}" {{#if cond.default}}checked{{/if}} />
        {{cond.label}} <span class="carl-dialog-condition-source">({{cm.label}})</span>
      </label>
      {{/each}}
      {{/each}}
    </div>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "CARLRPG.Dialog.SituationalModifier"}}</label>
    <div class="form-fields">
      <input type="number" name="modifier" value="0" autofocus />
    </div>
  </div>
</div>
