<div class="carl-chat-card">
  <header class="carl-chat-header">
    {{#if img}}<img src="{{img}}" class="carl-chat-img" alt="" />{{/if}}
    <div class="carl-chat-titles">
      <div class="carl-chat-title">{{title}}</div>
      {{#if subtitle}}<div class="carl-chat-subtitle">{{subtitle}}</div>{{/if}}
    </div>
    {{#if badge}}
    <span class="carl-badge carl-badge--{{badge.type}}">{{badge.label}}</span>
    {{/if}}
  </header>
  {{#if description}}
  <div class="carl-chat-desc-drawer collapsed">
    <button type="button" class="carl-chat-desc-toggle" data-action="toggleDescription" aria-expanded="false">
      <i class="fas fa-caret-down carl-caret" aria-hidden="true"></i>
      <span>{{localize "CARLRPG.Chat.Description"}}</span>
    </button>
    <div class="carl-chat-desc-body">
      <div class="carl-chat-desc">{{{description}}}</div>
    </div>
  </div>
  {{/if}}
  {{#if rollRows.length}}
  <table class="carl-chat-rolls">
    {{#each rollRows}}
    {{> carlChatRollRow}}
    {{/each}}
  </table>
  {{/if}}
  {{#if body}}
  <div class="carl-chat-body">{{{body}}}</div>
  {{/if}}
  {{#if footer}}
  <footer class="carl-chat-footer">{{{footer}}}</footer>
  {{/if}}
</div>
