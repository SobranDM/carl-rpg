{{!-- Shared Rank/Upgrades block for Skill, Spell, and Damage Effect item
      sheets - all three follow the book's "Rank 5/10/15 Upgrades" pattern.
      isAttackFlavored (item-sheet.mjs's _prepareContext) gates Base
      Damage/Heal fieldsets below - true for an Attack-category Skill, an
      "attack"-keyword Spell, or any Damage Effect (no heal concept). --}}
<div class="carl-field-grid">
  <div>
    <label class="resource-label">{{localize "CARLRPG.Ranked.GoverningStat"}}</label>
    <select class="carl-w-medium" name="system.governingStat">
      <option value=""></option>
      {{selectOptions config.stats selected=system.governingStat localize=true}}
    </select>
  </div>
  <div>
    <label class="resource-label">{{localize "CARLRPG.Ranked.OpposedStat"}}</label>
    <select class="carl-w-medium" name="system.opposedStat">
      <option value=""></option>
      {{selectOptions config.stats selected=system.opposedStat localize=true}}
    </select>
  </div>
  <div>
    <label class="resource-label">{{localize "CARLRPG.Ranked.Rank"}}</label>
    <input type="text" class="carl-w-tiny" name="system.rank" value="{{system.rank}}" data-dtype="Number" />
  </div>
  <div>
    <label class="resource-label">{{localize "CARLRPG.Ranked.AdvancementGate"}}</label>
    <select class="carl-w-wide" name="system.advancementGate">
      {{selectOptions config.advancementGates selected=system.advancementGate localize=true}}
    </select>
  </div>
</div>

{{!-- Marked is a bookkeeping flag ordinary Skill/Attack/Heal rolls set
      automatically (CarlDice.markForAdvancement) - the button below never
      reads it, but both are about the same Advancement-Check lifecycle, so
      they sit together here instead of competing with Governing Stat/Rank
      above for attention. --}}
<div class="carl-advancement-row flexrow">
  <label class="carl-marked-toggle">
    <input type="checkbox" name="system.marked" {{checked system.marked}} />
    {{localize "CARLRPG.Ranked.Marked"}}
  </label>
  {{#if canRollAdvancement}}
  <button type="button" class="carl-roll-advancement" data-action="rollAdvancement">
    <i class="fas fa-dice-d20"></i> {{localize "CARLRPG.Ranked.RollAdvancement"}}
  </button>
  {{/if}}
</div>

{{#if isAttackFlavored}}
<fieldset class="carl-base-damage">
  <legend>{{localize "CARLRPG.Ranked.BaseDamage"}}</legend>
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.BaseDamageDice"}}</label>
      <input type="text" class="carl-w-short" name="system.baseDamage.dice" value="{{system.baseDamage.dice}}" placeholder="1d4" />
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.BaseDamageStat"}}</label>
      <select class="carl-w-medium" name="system.baseDamage.stat">
        <option value=""></option>
        {{selectOptions config.stats selected=system.baseDamage.stat localize=true}}
      </select>
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.BaseDamageType"}}</label>
      <select class="carl-w-medium" name="system.baseDamage.damageType">
        <option value=""></option>
        {{selectOptions config.damageTypes selected=system.baseDamage.damageType localize=true}}
      </select>
    </div>
  </div>
</fieldset>
{{else}}
<fieldset class="carl-base-heal">
  <legend>{{localize "CARLRPG.Ranked.Heal"}}</legend>
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.HealDice"}}</label>
      <input type="text" class="carl-w-short" name="system.healDice" value="{{system.healDice}}" placeholder="1d4" />
    </div>
  </div>
</fieldset>
{{/if}}
