{{!-- The shared lower half of a Skill, Spell or Damage Effect's Main tab
      (docs/skill-item-sheets.md), after its Description and "What it is":
      Rank and advancement, Rolling it, Bonuses (at any Rank - Oakhide's
      +2 DR), Damage or Healing, On-hit Debuffs (at any Rank), and the
      Upgrades overview. isAttackFlavored
      (item-sheet.mjs's _prepareContext) picks Damage or Healing and shows
      the Debuffs - true for an Attack-category Skill, an "attack"-keyword
      Spell, or any Damage Effect. --}}
<div class="carl-item-group">
  <span class="carl-item-group-title">{{localize "CARLRPG.ItemSheet.Group.Advancement"}}
    <span class="carl-item-group-summary">{{localize (lookup config.advancementGates system.advancementGate)}}</span></span>
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.Rank"}}</label>
      {{#if petRank}}
      <input type="text" class="carl-w-tiny" value="{{petRank}}" disabled data-tooltip="{{localize 'CARLRPG.Pet.RankIsFloorHint'}}" />
      <span class="carl-hint">{{localize "CARLRPG.Pet.RankIsFloor"}}</span>
      {{else}}
      <input type="text" class="carl-w-tiny" name="system.rank" value="{{system.rank}}" data-dtype="Number" />
      {{/if}}
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.AdvancementGate"}}</label>
      <select class="carl-w-wide" name="system.advancementGate">
        {{selectOptions config.advancementGates selected=system.advancementGate localize=true}}
      </select>
    </div>
    {{!-- Marked is the bookkeeping flag ordinary rolls set
          (CarlDice.markForAdvancement); it sits with the Advancement roll. --}}
    <label class="carl-check-field carl-marked-toggle">
      <input type="checkbox" name="system.marked" {{checked system.marked}} />
      {{localize "CARLRPG.Ranked.Marked"}}
    </label>
    {{#if canRollAdvancement}}
    <button type="button" class="carl-roll-advancement" data-action="rollAdvancement">
      <i class="fas fa-dice-d20"></i> {{localize "CARLRPG.Ranked.RollAdvancement"}}
    </button>
    {{/if}}
  </div>
</div>

<div class="carl-item-group">
  <span class="carl-item-group-title">{{localize "CARLRPG.ItemSheet.Group.Rolling"}}</span>
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.GoverningStat"}}</label>
      <select class="carl-w-medium" name="system.governingStat">
        <option value=""></option>
        {{selectOptions config.stats selected=system.governingStat localize=true}}
      </select>
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.OpposedStat"}}</label>
      <select class="carl-w-medium" name="system.opposedStat">
        <option value=""></option>
        {{selectOptions config.stats selected=system.opposedStat localize=true}}
      </select>
    </div>
  </div>
</div>

{{!-- system.changes: the Bonuses it gives from Rank 1, on top of any
      Upgrade's. Every keyword has them (a Passive Spell's are its point). --}}
<div class="carl-item-group carl-base-bonuses">
  <span class="carl-item-group-title">{{localize "CARLRPG.ItemSheet.Group.Bonuses"}}
    <span class="carl-item-group-summary">{{localize "CARLRPG.ItemSheet.AnyRank"}}</span></span>
  {{> "systems/carl-rpg/templates/item/parts/changes-editor.hbs"
    changes=system.changes path="system.changes" config=config item=item actorSkillNames=actorSkillNames}}
</div>

{{#if isAttackFlavored}}
<div class="carl-item-group carl-base-damage">
  <span class="carl-item-group-title">{{localize "CARLRPG.ItemSheet.Group.Damage"}}
    {{#if damageSummary}}<span class="carl-item-group-summary">{{damageSummary}}</span>{{/if}}</span>
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.BaseDamageDice"}}</label>
      <input type="text" class="carl-w-short" name="system.baseDamage.dice" value="{{system.baseDamage.dice}}" placeholder="1d4" />
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.BaseDamageStat"}}</label>
      <select class="carl-w-medium" name="system.baseDamage.stat">
        <option value=""></option>
        {{selectOptions config.stats selected=system.baseDamage.stat localize=true}}
      </select>
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.BaseDamageType"}}</label>
      <select class="carl-w-medium" name="system.baseDamage.damageType">
        <option value=""></option>
        {{selectOptions config.damageTypes selected=system.baseDamage.damageType localize=true}}
      </select>
    </div>
    <label class="carl-check-field" data-tooltip="{{localize 'CARLRPG.ArmorPiercing.Hint'}}">
      <input type="checkbox" name="system.armorPiercing" {{checked system.armorPiercing}} />
      {{localize "CARLRPG.ArmorPiercing.AnyRank"}}
    </label>
  </div>
</div>

<div class="carl-item-group carl-base-debuffs">
  <span class="carl-item-group-title">{{localize "CARLRPG.ItemSheet.Group.Debuffs"}}
    <span class="carl-item-group-summary">{{localize "CARLRPG.ItemSheet.AnyRank"}}</span></span>
  {{> "systems/carl-rpg/templates/item/parts/target-effects-editor.hbs"
    targetEffects=system.targetEffects path="system.targetEffects" config=config}}
</div>
{{else}}
<div class="carl-item-group carl-base-heal">
  <span class="carl-item-group-title">{{localize "CARLRPG.ItemSheet.Group.Healing"}}</span>
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Ranked.HealDice"}}</label>
      <input type="text" class="carl-w-short" name="system.healDice" value="{{system.healDice}}" placeholder="1d4" />
    </div>
    {{!-- Who it can heal (module/helpers/heal-targets.mjs); blank goes by Range. --}}
    <div>
      <label class="resource-label" data-tooltip="{{localize 'CARLRPG.Ranked.HealsHint'}}">{{localize "CARLRPG.Ranked.Heals"}}</label>
      <select class="carl-w-medium" name="system.heals">
        {{selectOptions config.healsChoices selected=system.heals localize=true}}
      </select>
    </div>
    <label class="carl-check-field" data-tooltip="{{localize 'CARLRPG.Ranked.HealToFullBaseHint'}}">
      <input type="checkbox" name="system.healToFull" {{checked system.healToFull}} />
      {{localize "CARLRPG.Ranked.HealToFullBase"}}
    </label>
  </div>
</div>
{{/if}}

{{!-- One row per Rank tier: Unlocked or Locked at the current Rank and a
      one-line summary (item-sheet.mjs #upgradeOverview); a click opens its
      tab. --}}
<div class="carl-item-group carl-upgrades-overview">
  <span class="carl-item-group-title">{{localize "CARLRPG.ItemSheet.Group.Upgrades"}}</span>
  <div class="carl-edit-rows">
    {{#each upgradeOverview as |tier|}}
    <a class="carl-tier-link" data-action="showTab" data-tab="{{tier.tab}}">
      {{#if tier.unlocked}}
      <span class="carl-row-chip" data-tone="good"><i class="fas fa-lock-open"></i>{{localize "CARLRPG.ItemSheet.Unlocked"}}</span>
      {{else}}
      <span class="carl-row-chip" data-tone="muted"><i class="fas fa-lock"></i>{{localize "CARLRPG.ItemSheet.Locked"}}</span>
      {{/if}}
      <span class="carl-tier-link-rank">{{localize tier.label}}</span>
      <span class="carl-tier-link-summary{{#unless tier.count}} is-empty{{/unless}}">{{tier.summary}}</span>
      <i class="fas fa-chevron-right carl-tier-link-go"></i>
    </a>
    {{/each}}
  </div>
</div>
