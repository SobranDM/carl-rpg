{{!-- One Upgrade tier as a card (docs/skill-item-sheets.md): its Rank and
      an Unlocked / Locked chip in the header, its description, then only
      the parts it uses - Bonuses, On-hit Debuffs, Damage type split,
      Healing - with an add bar for the rest. Invoked by rank-tab.hbs with
      hash params `upgrade` (one system.upgrades[] entry), `uIndex` (its
      ORIGINAL index in the full system.upgrades array - every field's name
      path and deleteArrayItem's data-index need it), `damageTypeEntries`
      (#groupUpgradesByRank: its damage types as `{value, dtIndex}`, dtIndex
      the ORIGINAL index), `showHeal` / `showDamageTypes` / `showShield` (in
      use, or added from the add bar; Shield slots only on a Spell, `isSpell`),
      `unlocked`, `isAttackFlavored` (also shows its Armor-Piercing box), plus `config`/
      `item`/`actorSkillNames` passed through. Inside the
      `{{#each damageTypeEntries}}` loop anything from this scope needs
      `../`. --}}
<section class="carl-upgrade-tier carl-tier-card" data-upgrade-id="{{upgrade.id}}">
  <header class="carl-tier-card-head">
    <span class="carl-tier-card-title">{{localize "CARLRPG.ItemSheet.UpgradeTitle" rank=upgrade.rankThreshold}}</span>
    {{#if unlocked}}
    <span class="carl-row-chip" data-tone="good"><i class="fas fa-lock-open"></i>{{localize "CARLRPG.ItemSheet.Unlocked"}}</span>
    {{else}}
    <span class="carl-row-chip" data-tone="muted"><i class="fas fa-lock"></i>{{localize "CARLRPG.ItemSheet.Locked"}}</span>
    {{/if}}
    <span class="carl-tier-card-ctl">
      <select name="{{concat 'system.upgrades.' uIndex '.rankThreshold'}}" data-dtype="Number"
        aria-label="{{localize 'CARLRPG.Ranked.Rank'}}" data-tooltip="{{localize 'CARLRPG.ItemSheet.MoveUpgrade'}}">
        <option value="5" {{#if (eq upgrade.rankThreshold 5)}}selected{{/if}}>{{localize "CARLRPG.Ranked.Rank5"}}</option>
        <option value="10" {{#if (eq upgrade.rankThreshold 10)}}selected{{/if}}>{{localize "CARLRPG.Ranked.Rank10"}}</option>
        <option value="15" {{#if (eq upgrade.rankThreshold 15)}}selected{{/if}}>{{localize "CARLRPG.Ranked.Rank15"}}</option>
      </select>
      <a class="carl-edit-row-icon" data-action="deleteArrayItem" data-path="system.upgrades" data-index="{{uIndex}}"
        data-tooltip="{{localize 'CARLRPG.Ranked.RemoveUpgrade'}}" aria-label="{{localize 'CARLRPG.Ranked.RemoveUpgrade'}}">
        <i class="fas fa-trash"></i>
      </a>
    </span>
  </header>
  <div class="carl-tier-card-body">
    {{!-- Posted so a submit keeps the tier's id (its revealed parts are keyed on it). --}}
    <input type="hidden" name="{{concat 'system.upgrades.' uIndex '.id'}}" value="{{upgrade.id}}" />
    <textarea name="{{concat 'system.upgrades.' uIndex '.description'}}" class="carl-upgrade-description"
      placeholder="{{localize 'CARLRPG.ItemSheet.UpgradeDescriptionPlaceholder'}}">{{upgrade.description}}</textarea>

    {{#if upgrade.changes.length}}
    <div class="carl-tier-part">
      <span class="carl-tier-part-title">{{localize "CARLRPG.ItemSheet.Group.Bonuses"}}</span>
      {{> "systems/carl-rpg/templates/item/parts/changes-editor.hbs"
        changes=upgrade.changes path=(concat "system.upgrades." uIndex ".changes") config=config
        item=item actorSkillNames=actorSkillNames noAdd=true}}
    </div>
    {{/if}}

    {{#if upgrade.targetEffects.length}}
    <div class="carl-tier-part">
      <span class="carl-tier-part-title">{{localize "CARLRPG.ItemSheet.Group.Debuffs"}}</span>
      {{> "systems/carl-rpg/templates/item/parts/target-effects-editor.hbs"
        targetEffects=upgrade.targetEffects path=(concat "system.upgrades." uIndex ".targetEffects") config=config noAdd=true}}
    </div>
    {{/if}}

    {{#if showDamageTypes}}
    <div class="carl-tier-part carl-upgrade-damage-split">
      <span class="carl-tier-part-title">{{localize "CARLRPG.Ranked.DamageTypeSplit"}}</span>
      {{#each damageTypeEntries as |entry|}}
      <div class="carl-string-list-row flexrow">
        <select class="carl-w-medium" name="{{concat 'system.upgrades.' ../uIndex '.damageTypes.' entry.dtIndex}}">
          <option value=""></option>
          {{selectOptions ../config.damageTypes selected=entry.value localize=true}}
        </select>
        <a class="item-control" data-action="deleteArrayItem"
          data-path="{{concat 'system.upgrades.' ../uIndex '.damageTypes'}}" data-index="{{entry.dtIndex}}">
          <i class="fas fa-times"></i>
        </a>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if showHeal}}
    <div class="carl-tier-part carl-upgrade-heal">
      <span class="carl-tier-part-title">{{localize "CARLRPG.ItemSheet.Group.Healing"}}</span>
      <div class="carl-field-grid">
        <div>
          <label class="resource-label">{{localize "CARLRPG.Ranked.HealDice"}}</label>
          <input type="text" class="carl-w-short" name="{{concat 'system.upgrades.' uIndex '.healDice'}}"
            value="{{upgrade.healDice}}" placeholder="1d6" />
        </div>
        <label class="carl-check-field">
          <input type="checkbox" name="{{concat 'system.upgrades.' uIndex '.healToFull'}}" {{checked upgrade.healToFull}} />
          {{localize "CARLRPG.Ranked.HealToFull"}}
        </label>
        <label class="carl-check-field">
          <input type="checkbox" name="{{concat 'system.upgrades.' uIndex '.healMend'}}" {{checked upgrade.healMend}} />
          {{localize "CARLRPG.Ranked.HealMend"}}
        </label>
        <label class="carl-check-field" data-tooltip="{{localize 'CARLRPG.Ranked.HealAllTargetsHint'}}">
          <input type="checkbox" name="{{concat 'system.upgrades.' uIndex '.healAllTargets'}}" {{checked upgrade.healAllTargets}} />
          {{localize "CARLRPG.Ranked.HealAllTargets"}}
        </label>
      </div>
    </div>
    {{/if}}

    {{#if showShield}}
    {{!-- A Shield-type Spell's pool size from this Rank on (0: unchanged). --}}
    <div class="carl-tier-part carl-upgrade-shield">
      <span class="carl-tier-part-title">{{localize "CARLRPG.Spell.ShieldSlots"}}</span>
      <div class="carl-field-grid">
        <div>
          <input type="text" class="carl-w-tiny" name="{{concat 'system.upgrades.' uIndex '.shieldSlots'}}"
            value="{{upgrade.shieldSlots}}" data-dtype="Number" aria-label="{{localize 'CARLRPG.Spell.ShieldSlots'}}" />
          <span class="carl-hint">{{localize "CARLRPG.Spell.ShieldSlotsTierHint"}}</span>
        </div>
      </div>
    </div>
    {{/if}}

    {{#if isAttackFlavored}}
    <label class="carl-check-field carl-upgrade-armor-piercing" data-tooltip="{{localize 'CARLRPG.ArmorPiercing.Hint'}}">
      <input type="checkbox" name="{{concat 'system.upgrades.' uIndex '.armorPiercing'}}" {{checked upgrade.armorPiercing}} />
      {{localize "CARLRPG.ArmorPiercing.FromRank"}}
    </label>
    {{/if}}

    <div class="carl-add-bar">
      <span class="carl-add-bar-label">{{localize "CARLRPG.ItemSheet.AddBar"}}</span>
      <button type="button" data-action="addArrayItem" data-path="{{concat 'system.upgrades.' uIndex '.changes'}}" data-template="{}">
        <i class="fas fa-plus"></i> {{localize "CARLRPG.ItemSheet.AddBonus"}}</button>
      {{#if (or isAttackFlavored upgrade.targetEffects.length)}}
      <button type="button" data-action="addArrayItem" data-path="{{concat 'system.upgrades.' uIndex '.targetEffects'}}"
        data-template='{"debuffKey":"","stacks":1,"critOnly":false,"amazingSuccessOnly":false,"label":""}'>
        <i class="fas fa-plus"></i> {{localize "CARLRPG.ItemSheet.AddDebuff"}}</button>
      {{/if}}
      {{#if isAttackFlavored}}
      <button type="button" data-action="addDamageType" data-index="{{uIndex}}">
        <i class="fas fa-plus"></i> {{localize "CARLRPG.ItemSheet.AddDamageType"}}</button>
      {{/if}}
      {{#unless showHeal}}
      <button type="button" data-action="revealPart" data-reveal="{{concat 'heal-' upgrade.id}}">
        <i class="fas fa-plus"></i> {{localize "CARLRPG.ItemSheet.AddHealing"}}</button>
      {{/unless}}
      {{#if isSpell}}{{#unless showShield}}
      <button type="button" data-action="revealPart" data-reveal="{{concat 'shield-' upgrade.id}}">
        <i class="fas fa-plus"></i> {{localize "CARLRPG.ItemSheet.AddShieldSlots"}}</button>
      {{/unless}}{{/if}}
    </div>
  </div>
</section>
