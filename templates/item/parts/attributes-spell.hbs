<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="main">
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Spell.ManaCost"}}</label>
      <input type="text" class="carl-w-tiny" name="system.manaCost" value="{{system.manaCost}}" data-dtype="Number" />
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Spell.Range"}}</label>
      <input type="text" class="carl-w-short" name="system.range" value="{{system.range}}" placeholder="Melee" />
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Spell.Duration"}}</label>
      <input type="text" class="carl-w-short" name="system.duration" value="{{system.duration}}" />
    </div>
    <div>
      <label class="resource-label">{{localize "CARLRPG.Spell.Cooldown"}}</label>
      <input type="text" class="carl-w-short" name="system.cooldown" value="{{system.cooldown}}" />
    </div>
  </div>

  <div class="resource">
    <label class="resource-label">{{localize "CARLRPG.Spell.CastingKeywords"}}</label>
    <select class="carl-w-medium" name="system.castingKeywords" multiple size="6">
      {{selectOptions config.castingKeywords selected=system.castingKeywords localize=true}}
    </select>
  </div>

  <fieldset class="carl-string-list">
    <legend>{{localize "CARLRPG.Spell.FavoredClasses"}}</legend>
    {{#each system.favoredClasses as |cls index|}}
    <div class="carl-string-list-row flexrow">
      <input type="text" name="{{concat 'system.favoredClasses.' index}}" value="{{cls}}" />
      <a class="item-control" data-action="deleteArrayItem" data-path="system.favoredClasses" data-index="{{index}}">
        <i class="fas fa-times"></i>
      </a>
    </div>
    {{/each}}
    <a class="item-control carl-add-link" data-action="addArrayItem" data-path="system.favoredClasses" data-template="&quot;&quot;">
      <i class="fas fa-plus"></i> {{localize "CARLRPG.Spell.AddFavoredClass"}}
    </a>
  </fieldset>

  {{> "systems/carl-rpg/templates/item/parts/ranked-fields.hbs" system=system config=config
      canRollAdvancement=canRollAdvancement isAttackFlavored=isAttackFlavored}}

  <hr class="carl-section-divider" />
  <h4 class="carl-section-header">{{localize "CARLRPG.Tab.Description"}}</h4>
  <hr class="carl-section-divider" />
  {{> "systems/carl-rpg/templates/item/parts/description-editor.hbs"}}
</section>
