<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="main">
  <div class="carl-field-grid">
    <div>
      <label class="resource-label">{{localize "CARLRPG.Skill.Category"}}</label>
      <select class="carl-w-medium" name="system.category">
        {{selectOptions config.skillCategories selected=system.category localize=true}}
      </select>
    </div>
    {{#if isAttackFlavored}}
    <div>
      <label class="resource-label">{{localize "CARLRPG.Skill.AttackType"}}</label>
      <select class="carl-w-short" name="system.attackType">
        <option value=""></option>
        {{selectOptions config.attackTypes selected=system.attackType localize=true}}
      </select>
    </div>
    {{/if}}
    <div>
      <label class="resource-label">{{localize "CARLRPG.Skill.Range"}}</label>
      <input type="text" class="carl-w-short" name="system.range" value="{{system.range}}" placeholder="5 ft" />
    </div>
    {{#if isAttackFlavored}}
    <div>
      <label class="resource-label">{{localize "CARLRPG.Skill.AiFavor"}}</label>
      <input type="text" class="carl-w-tiny" name="system.aiFavor" value="{{system.aiFavor}}" data-dtype="Number" />
    </div>
    {{/if}}
    <div>
      <label class="resource-label">{{localize "CARLRPG.Skill.Cooldown"}}</label>
      <input type="text" class="carl-w-short" name="system.cooldown" value="{{system.cooldown}}" />
    </div>
  </div>
  <div class="resource">
    <label class="resource-label">{{localize "CARLRPG.Skill.Limitations"}}</label>
    <input type="text" class="carl-w-full" name="system.limitations" value="{{system.limitations}}" />
  </div>

  {{> "systems/carl-rpg/templates/item/parts/ranked-fields.hbs" system=system config=config
      canRollAdvancement=canRollAdvancement isAttackFlavored=isAttackFlavored}}

  <hr class="carl-section-divider" />
  <h4 class="carl-section-header">{{localize "CARLRPG.Tab.Description"}}</h4>
  <hr class="carl-section-divider" />
  {{> "systems/carl-rpg/templates/item/parts/description-editor.hbs"}}
</section>
