{{!-- A Character's Benefits tab (its "features" slot - actor-sheet.mjs
      PART_TEMPLATES / TAB_LABELS_BY_TYPE; Mobs and Pets keep
      features-list.hbs). In play it's a reference: what the Race and Class
      grant (each item's description, its benefits list), the deity's
      church benefits, and any other perks. Context: #prepareBenefits. --}}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="features">
  {{!-- Race and Class: a panel each, active first. A second, unlinked one
        (mid Third-Floor re-selection) lists too, so it can be deleted. --}}
  {{#each benefitPanels as |panel|}}
  <section class="carl-drawer carl-benefit-panel item{{#unless panel.expanded}} collapsed{{/unless}}" data-item-id="{{panel.id}}">
    <div class="carl-drawer-header" data-action="toggleDrawer" data-scope="actor" data-path="{{panel.togglePath}}">
      <i class="fas fa-caret-down carl-drawer-caret"></i>
      <img class="carl-benefit-img" src="{{panel.img}}" alt="" width="20" height="20" />
      <span class="carl-drawer-label">{{panel.name}}</span>
      <span class="carl-benefit-type">{{panel.typeLabel}}</span>
      {{#if panel.active}}<span class="carl-benefit-active">{{localize "CARLRPG.Actor.Active"}}</span>{{/if}}
      <span class="carl-benefit-controls">
        <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type=panel.typeLabel}}">
          <i class="fas fa-edit"></i>
        </a>
        <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type=panel.typeLabel}}">
          <i class="fas fa-trash"></i>
        </a>
      </span>
    </div>
    <div class="carl-drawer-body">
      <div class="carl-benefit-text">
        {{#if panel.html}}{{{panel.html}}}{{else}}<p class="carl-hint">{{localize "CARLRPG.Benefits.NoText"}}</p>{{/if}}
      </div>
    </div>
  </section>
  {{else}}
  <p class="carl-hint carl-benefits-empty">{{localize "CARLRPG.Benefits.NoRaceOrClass"}}</p>
  {{/each}}

  {{!-- Worship (pp.163-164, 312). --}}
  <fieldset class="carl-deity">
    <legend>{{localize "CARLRPG.Actor.Deity"}}</legend>
    <div class="carl-deity-line">
      <input type="text" class="carl-deity-name" name="system.deity.name" value="{{system.deity.name}}"
        placeholder="{{localize 'CARLRPG.Deity.NamePlaceholder'}}" />
      <select class="carl-w-short" name="system.deity.tier" title="{{localize 'CARLRPG.Deity.Tier'}}">
        {{selectOptions deity.tierChoices selected=system.deity.tier localize=true}}
      </select>
      {{#if deity.tithe}}
      <span class="carl-deity-tithe" title="{{localize 'CARLRPG.Deity.TitheHint'}}">{{localize "CARLRPG.Deity.Tithe" percent=deity.tithe}}</span>
      {{/if}}
    </div>
    <div class="carl-deity-line">
      <span class="resource-label" title="{{localize 'CARLRPG.Deity.WorshipDaysHint'}}">{{localize "CARLRPG.Deity.WorshipDays"}}</span>
      <input type="text" class="carl-w-tiny" name="system.deity.worshipDays" value="{{system.deity.worshipDays}}" data-dtype="Number" />
      <a class="carl-deity-add-day" data-action="addWorshipDay" title="{{localize 'CARLRPG.Deity.AddDay'}}"><i class="fas fa-plus"></i>1</a>
      <span class="carl-deity-next{{#if deity.boonDue}} due{{/if}}">
        {{#if deity.boonDue}}{{localize "CARLRPG.Deity.BoonDue"}}{{else}}{{localize "CARLRPG.Deity.DaysToBoon" days=deity.daysToNextBoon}}{{/if}}
      </span>
      <button type="button" class="carl-deity-boon" data-action="receiveBoon" title="{{localize 'CARLRPG.Deity.ReceiveBoonHint'}}"
        {{#unless (or deity.canReceive isGM)}}disabled{{/unless}}>
        <i class="fas fa-gift"></i> {{localize "CARLRPG.Deity.ReceiveBoon"}}
      </button>
    </div>
    <div class="carl-deity-line">
      <span class="resource-label">{{localize "CARLRPG.Deity.MissedOfferings"}}</span>
      <span class="carl-missed-pips">
        {{#each deity.missedPips as |pip|}}
        <span class="carl-missed-pip{{#if pip.filled}} filled{{/if}}" data-action="setMissedOfferings" data-value="{{pip.value}}"
          title="{{localize pip.hint}}"></span>
        {{/each}}
      </span>
      <label class="carl-deity-flag"><input type="checkbox" name="system.deity.shunned" {{checked system.deity.shunned}} /> {{localize "CARLRPG.Deity.Shunned"}}</label>
      <label class="carl-deity-flag"><input type="checkbox" name="system.deity.fallen" {{checked system.deity.fallen}} /> {{localize "CARLRPG.Deity.Fallen"}}</label>
      <select class="carl-w-short" name="system.deity.penitence" data-dtype="Number" title="{{localize 'CARLRPG.Deity.PenitenceHint'}}">
        {{selectOptions deity.penitenceChoices selected=system.deity.penitence localize=true}}
      </select>
    </div>
    {{#if deity.suspended}}<p class="carl-deity-warning">{{localize "CARLRPG.Deity.Suspended"}}</p>{{/if}}

    {{!-- The deity's church benefits: Boon (feature) items with a Tier.
          One that doesn't apply (above the crawler's Tier, or worship
          suspended) is dimmed, not hidden, and grants nothing. --}}
    <ol class="items-list carl-deity-benefits">
      <li class="item flexrow items-header">
        <div class="item-name">{{localize "CARLRPG.Deity.TierBenefits"}}</div>
        <div class="item-prop">{{localize "CARLRPG.Feature.Tier"}}</div>
        <div class="item-controls">
          <a class="item-control item-create" data-action="createItem" data-type="feature"
            data-tier="{{#if system.deity.tier}}{{system.deity.tier}}{{else}}acolyte{{/if}}">
            <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type=(localize "CARLRPG.Benefits.Benefit")}}
          </a>
        </div>
      </li>
      {{#each deity.benefits as |item|}}
      {{> benefitRow item=item}}
      {{else}}
      <li class="carl-hint carl-benefits-none">{{localize "CARLRPG.Deity.NoTierBenefits"}}</li>
      {{/each}}
    </ol>

    <prose-mirror name="system.deity.notes" toggled value="{{system.deity.notes}}" data-document-uuid="{{actor.uuid}}" {{#unless editable}}disabled{{/unless}}>
      {{{deity.notesHTML}}}
    </prose-mirror>
  </fieldset>

  {{!-- Everything else: titles, Patron perks and other untiered Boons. --}}
  <ol class="items-list carl-perks">
    <li class="item flexrow items-header">
      <div class="item-name">{{localize "CARLRPG.Benefits.Other"}}</div>
      <div class="item-prop"></div>
      <div class="item-controls">
        <a class="item-control item-create" data-action="createItem" data-type="feature">
          <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type=(localize "CARLRPG.Benefits.Benefit")}}
        </a>
      </div>
    </li>
    {{#each perks as |item|}}
    {{> benefitRow item=item}}
    {{/each}}
  </ol>
</section>

{{#*inline "benefitRow"}}
<li class="item flexrow{{#unless item.applies}} carl-benefit-unreached{{/unless}}" data-item-id="{{item._id}}"
  {{#unless item.applies}}title="{{localize item.inactiveHint}}"{{/unless}}>
  <div class="item-name">
    <div class="item-image">
      <a class="rollable" data-action="roll" data-roll-type="item">
        <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
      </a>
    </div>
    <h4{{itemTooltip (lookup @root.itemTooltips item._id)}}>{{item.name}}</h4>
  </div>
  <div class="item-prop">{{#if item.tierLabel}}{{localize item.tierLabel}}{{/if}}</div>
  <div class="item-controls">
    <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type=(localize 'CARLRPG.Benefits.Benefit')}}">
      <i class="fas fa-edit"></i>
    </a>
    <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type=(localize 'CARLRPG.Benefits.Benefit')}}">
      <i class="fas fa-trash"></i>
    </a>
  </div>
</li>
{{/inline}}
