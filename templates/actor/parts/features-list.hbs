<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="features">
  {{#if raceAndClass.length}}
  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name">{{localize "CARLRPG.Actor.RaceAndClass"}}</div>
      <div class="item-prop"></div>
      <div class="item-controls"></div>
    </li>
    {{#each raceAndClass as |item id|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <div class="item-image">
          <a class="rollable" data-action="roll" data-roll-type="item">
            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
          </a>
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-prop">
        {{item.typeLabel}}
        {{#if (or (eq item._id ../classId) (eq item._id ../raceId))}}
        <span class="carl-race-class-active-badge">{{localize "CARLRPG.Actor.Active"}}</span>
        {{/if}}
      </div>
      <div class="item-controls">
        <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type=item.typeLabel}}">
          <i class="fas fa-edit"></i>
        </a>
        <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type=item.typeLabel}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
    {{/each}}
  </ol>
  {{/if}}
  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name">{{localize "Name"}}</div>
      <div class="item-prop">{{localize "CARLRPG.Feature.Tier"}}</div>
      <div class="item-controls">
        <a class="item-control item-create" data-action="createItem" data-type="feature">
          <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type="Boon"}}
        </a>
      </div>
    </li>
    {{#each features as |item id|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <div class="item-image">
          <a class="rollable" data-action="roll" data-roll-type="item">
            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
          </a>
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-prop">{{#if item.system.tier}}{{localize (lookup config.featureTiers item.system.tier)}}{{/if}}</div>
      <div class="item-controls">
        <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Boon'}}">
          <i class="fas fa-edit"></i>
        </a>
        <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Boon'}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
    {{/each}}
  </ol>
</section>
