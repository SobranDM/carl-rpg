{{!-- A Mob's Combat tab (docs/mob-sheet.md), the Character's shape: the Stats
      column, then the Defenses (the stat block's Surprise and Evade as
      "13+F" with today's value, DR, Move, Actions per round, and the
      Resistances - their grid opens here to edit), then the Attacks.
      Mobs never roll (p.267), so there's no Evade roll. Skills and Spells
      are on their own tab (skills-tab.hbs). --}}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <div class="carl-abilities-layout">
    {{> "systems/carl-rpg/templates/actor/parts/stats-column.hbs"}}

    <div class="carl-abilities-main">
      <fieldset class="carl-combat-defenses carl-mob-defenses">
        <legend>{{localize "CARLRPG.Actor.Defenses"}}</legend>
        <div class="carl-defenses-row">
          <span class="carl-defense-field carl-mob-defense" data-tooltip="{{localize 'CARLRPG.Actor.SurpriseHint'}}">
            <span class="resource-label">{{localize "CARLRPG.Roll.Surprise"}}</span>
            <span class="carl-stat-value">{{system.surpriseBase}}+F <small class="carl-mob-defense-now" data-tooltip="{{localize 'CARLRPG.Actor.AtFloor' floor=currentFloor}}">({{mobDefenses.surprise}})</small></span>
            {{#if system.surpriseDebuffDelta}}<i class="fas fa-skull-crossbones carl-debuffed-marker" data-tooltip="{{localize 'CARLRPG.Actor.DebuffedValueHint'}} ({{system.surpriseDebuffDelta}})"></i>{{/if}}
          </span>
          <span class="carl-defense-field carl-mob-defense" data-tooltip="{{localize 'CARLRPG.Actor.EvadeHint'}}">
            <span class="resource-label">{{localize "CARLRPG.Roll.Evade"}}</span>
            <span class="carl-stat-value">{{system.evadeBase}}+F <small class="carl-mob-defense-now" data-tooltip="{{localize 'CARLRPG.Actor.AtFloor' floor=currentFloor}}">({{mobDefenses.evade}})</small></span>
            {{#if system.evadeDebuffDelta}}<i class="fas fa-skull-crossbones carl-debuffed-marker" data-tooltip="{{localize 'CARLRPG.Actor.DebuffedValueHint'}} ({{system.evadeDebuffDelta}})"></i>{{/if}}
          </span>
          {{!-- The only system.dr input on the sheet (a second one would
                submit as an array). --}}
          <label class="carl-defense-field">
            <span class="resource-label">{{localize "CARLRPG.Actor.DrShort"}}</span>
            <input type="text" class="carl-w-tiny" name="system.dr" value="{{system.dr}}" data-dtype="Number" />
            {{#if system.drBonus}}<span class="carl-stat-value" data-tooltip="{{localize 'CARLRPG.Actor.EffectiveValue'}}">= {{system.drEffective}}</span>{{/if}}
          </label>
          <label class="carl-defense-field">
            <span class="resource-label">{{localize "CARLRPG.Actor.Move"}}</span>
            <input type="text" class="carl-w-tiny" name="system.move" value="{{system.move}}" placeholder="20+S" />
          </label>
          <label class="carl-defense-field" data-tooltip="{{localize 'CARLRPG.Actor.ActionsPerRoundHint'}}">
            <span class="resource-label">{{localize "CARLRPG.Actor.ActionsShort"}}</span>
            <input type="number" class="carl-w-tiny" name="system.actionsPerRound" value="{{system.actionsPerRound}}" min="0"
              placeholder="{{localize 'CARLRPG.Actor.ActionsAuto'}}" />
          </label>
          <button type="button" class="carl-resistances-button{{#if mobDefenses.resistancesOpen}} is-open{{/if}}" data-action="toggleMobResistances"
            aria-expanded="{{#if mobDefenses.resistancesOpen}}true{{else}}false{{/if}}">
            {{localize "CARLRPG.Actor.Resistances"}}
            <span class="carl-resistances-summary">{{#if resistanceSummary}}{{resistanceSummary}}{{else}}{{localize "CARLRPG.Actor.ResistNone"}}{{/if}}</span>
          </button>
        </div>
        {{#if mobDefenses.resistancesOpen}}
        <div class="carl-mob-resistances">
          {{> "systems/carl-rpg/templates/actor/parts/resistances-grid.hbs"}}
        </div>
        {{/if}}
      </fieldset>

      {{> "systems/carl-rpg/templates/actor/parts/mob-attacks-list.hbs"}}
    </div>
  </div>
</section>
