{{!-- One Damage Effect row. Used both nested under a matching parent Skill
      (where the parent-skills list is redundant - you're already looking at
      it from that parent's perspective, so `hideParents` suppresses it) and
      in the "Unassigned Damage Effects" fallback list (where it's still
      useful context). Invoke with `item` set to the Damage Effect. --}}
<li class="item flexrow" data-item-id="{{item._id}}">
  <div class="item-name">
    <div class="item-image">
      <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
    </div>
    <h4>{{item.name}}</h4>
  </div>
  <div class="item-prop">{{#unless hideParents}}{{item.parentSkillsText}}{{/unless}}</div>
  <div class="item-prop">{{item.system.rank}}</div>
  <div class="item-controls">
    {{#if locked}}
    <a class="item-control" data-action="toggleMark" title="{{localize 'CARLRPG.Ranked.ToggleMark'}}">
      <i class="fas {{#if item.system.marked}}fa-check-square{{else}}fa-square{{/if}}"></i>
    </a>
    {{else}}
    <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='DamageEffect'}}">
      <i class="fas fa-edit"></i>
    </a>
    <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='DamageEffect'}}">
      <i class="fas fa-trash"></i>
    </a>
    {{/if}}
  </div>
</li>
