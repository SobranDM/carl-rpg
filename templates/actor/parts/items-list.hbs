<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="items">
  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name">{{localize "Name"}}</div>
      <div class="item-prop">{{localize "CARLRPG.Item.Quantity"}}</div>
      <div class="item-prop">{{localize "CARLRPG.Item.Weight"}}</div>
      <div class="item-controls">
        <a class="item-control item-create" data-action="createItem" data-type="item">
          <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type="Item"}}
        </a>
      </div>
    </li>
    {{#each gear as |item id|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <div class="item-image">
          <a class="rollable" data-action="roll" data-roll-type="item">
            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
          </a>
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-prop">{{item.system.quantity}}</div>
      <div class="item-prop">{{item.system.weight}}</div>
      <div class="item-controls">
        <a class="item-control" data-action="toggleEquipped" title="{{localize 'CARLRPG.Item.Equipped'}}">
          <i class="fas {{#if item.system.equipped}}fa-check-square{{else}}fa-square{{/if}}"></i>
        </a>
        <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Item'}}">
          <i class="fas fa-edit"></i>
        </a>
        <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Item'}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
    {{/each}}
  </ol>
</section>
