<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="items">
  <div class="carl-inventory-layout">
  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name carl-sort-header" data-action="sortList" data-list="gear" data-sort-key="name">{{localize "Name"}} <i class="fas {{@root.listSort.gear.name}}"></i></div>
      <div class="item-prop carl-sort-header" data-action="sortList" data-list="gear" data-sort-key="quantity">{{localize "CARLRPG.Item.Quantity"}} <i class="fas {{@root.listSort.gear.quantity}}"></i></div>
      <div class="item-prop carl-sort-header" data-action="sortList" data-list="gear" data-sort-key="weight">{{localize "CARLRPG.Item.Weight"}} <i class="fas {{@root.listSort.gear.weight}}"></i></div>
      <div class="item-controls">
        <a class="item-control item-create" data-action="createItem" data-type="item">
          <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type="Item"}}
        </a>
      </div>
    </li>
    {{#each gear as |item id|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <div class="item-image">
          <a class="rollable" data-action="roll" data-roll-type="item">
            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
          </a>
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-prop">{{item.system.quantity}}</div>
      <div class="item-prop">{{item.system.weight}}</div>
      <div class="item-controls">
        {{#if item.system.consumable.kind}}
        <a class="item-control carl-use-item" data-action="useItem" title="{{localize 'CARLRPG.Consumable.Use'}}">
          <i class="fas fa-flask"></i>
        </a>
        {{/if}}
        <a class="item-control" data-action="toggleEquipped" title="{{localize 'CARLRPG.Item.Equipped'}}">
          <i class="fas {{#if item.system.equipped}}fa-check-square{{else}}fa-square{{/if}}"></i>
        </a>
        <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Item'}}">
          <i class="fas fa-edit"></i>
        </a>
        <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Item'}}">
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
    {{/each}}
  </ol>

  {{!-- Character only: drop an inventory row onto a slot to fill it. Each
        slot stores the item's id, see helpers/equip-slots.mjs. A gear or
        accessory slot marks the item equipped; unticking Equipped above
        takes it back out. --}}
  {{#if equipSlots}}
  <aside class="carl-equip-panel">
    <fieldset class="carl-hotlist">
      <legend>{{localize "CARLRPG.Actor.Hotlist"}}</legend>
      <ol class="carl-hotlist-slots">
        {{#each equipSlots.hotlist as |slot|}}
        <li class="carl-equip-slot carl-hotlist-slot{{#if slot.name}} filled{{/if}}" data-slot-type="hotlist" data-slot-key="{{slot.index}}" title="{{#if slot.name}}{{slot.name}}{{else}}{{localize 'CARLRPG.Actor.DropItemHere'}}{{/if}}">
          <span class="carl-hotlist-index">{{slot.number}}</span>
          {{#if slot.img}}<img src="{{slot.img}}" alt="" width="20" height="20" />{{/if}}
          <span class="carl-equip-slot-name">{{slot.name}}</span>
          {{#if slot.usable}}
          <a class="item-control carl-slot-use" data-action="useItem" data-item-id="{{slot.itemId}}" title="{{localize 'CARLRPG.Consumable.Use'}}"><i class="fas fa-flask"></i></a>
          {{/if}}
          {{#if slot.name}}
          <a class="item-control carl-slot-clear" data-action="clearSlot" title="{{localize 'CARLRPG.Actor.ClearSlot'}}"><i class="fas fa-times"></i></a>
          {{/if}}
        </li>
        {{/each}}
      </ol>
    </fieldset>

    <fieldset class="carl-equipped">
      <legend>{{localize "CARLRPG.Item.Equipped"}}</legend>
      <div class="carl-gear-grid">
        {{#each equipSlots.gear as |slot|}}
        <div class="carl-equip-slot carl-gear-slot{{#if slot.name}} filled{{/if}}" style="grid-area: {{slot.key}}" data-slot-type="gear" data-slot-key="{{slot.key}}" title="{{#if slot.name}}{{slot.name}}{{else}}{{localize slot.label}}{{/if}}">
          {{#if slot.img}}<img src="{{slot.img}}" alt="" />{{else}}<span class="carl-gear-icon" style="mask-image: url('{{slot.icon}}')"></span>{{/if}}
          <span class="carl-equip-slot-name">{{#if slot.name}}{{slot.name}}{{else}}{{localize slot.label}}{{/if}}</span>
          {{#if slot.name}}
          <a class="item-control carl-slot-clear" data-action="clearSlot" title="{{localize 'CARLRPG.Actor.ClearSlot'}}"><i class="fas fa-times"></i></a>
          {{/if}}
        </div>
        {{/each}}
      </div>

      <div class="resource-label carl-accessories-label">
        {{localize "CARLRPG.Actor.AccessoriesCount" count=equipSlots.accessoryCount max=equipSlots.accessoryMax}}
      </div>
      <div class="carl-accessory-slots">
        {{#each equipSlots.accessories as |slot|}}
        <div class="carl-equip-slot carl-gear-slot filled" data-slot-type="accessory" data-slot-key="{{slot.index}}" title="{{slot.name}}">
          {{#if slot.img}}<img src="{{slot.img}}" alt="" />{{else}}<span class="carl-gear-icon" style="mask-image: url('{{@root.config.accessoryIcon}}')"></span>{{/if}}
          <span class="carl-equip-slot-name">{{slot.name}}</span>
          <a class="item-control carl-slot-clear" data-action="clearSlot" title="{{localize 'CARLRPG.Actor.ClearSlot'}}"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
        {{#if equipSlots.canAddAccessory}}
        <div class="carl-equip-slot carl-gear-slot" data-slot-type="accessory" data-slot-key="{{equipSlots.nextAccessoryIndex}}" title="{{localize 'CARLRPG.Actor.DropItemHere'}}">
          <span class="carl-gear-icon" style="mask-image: url('{{@root.config.accessoryIcon}}')"></span>
          <span class="carl-equip-slot-name">{{localize "CARLRPG.Actor.AddAccessory"}}</span>
        </div>
        {{/if}}
      </div>
    </fieldset>
  </aside>
  {{/if}}
  </div>
</section>
