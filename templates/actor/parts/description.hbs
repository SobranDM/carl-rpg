<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="description">
  {{!-- Mobs and Pets: Biography only. A Character's version of this tab is
        its Details tab (details.hbs). --}}
  {{!-- The editor itself has no border/background while inactive (Foundry
        core only shows its rendered content, no chrome, until hovered) - a
        heading here is the only visual signal this section exists at all,
        especially with no biography text yet written. --}}
  {{!-- A Mob's is its stat block's "Notes:" (the Notes tab). --}}
  <label class="resource-label">{{#if isMob}}{{localize "CARLRPG.Tab.Notes"}}{{else}}{{localize "CARLRPG.Actor.Biography"}}{{/if}}</label>
  <prose-mirror name="system.biography" toggled value="{{actor.system.biography}}" data-document-uuid="{{actor.uuid}}" {{#unless editable}}disabled{{/unless}}>
    {{{biographyHTML}}}
  </prose-mirror>
  {{#if isMob}}
  {{!-- What the System AI tells crawlers (system.aiText): also shown when
        its token is hovered (module/apps/ai-text-tooltip.mjs). --}}
  <label class="resource-label carl-ai-text-label">{{localize "CARLRPG.AiText.Label"}}</label>
  <prose-mirror name="system.aiText" toggled value="{{actor.system.aiText}}" data-document-uuid="{{actor.uuid}}" {{#unless editable}}disabled{{/unless}}>
    {{{aiTextHTML}}}
  </prose-mirror>
  {{/if}}
</section>
