{{!-- The Hotlist (p.98, module/helpers/hotlist.mjs): ten slots of items,
      Spells or anything else at the ready. Click an empty slot to pick what
      goes in (or use the star on an Inventory/Spell row); click a filled one
      to use it - Cast a Spell, Use a consumable (after a confirmation),
      Ready gear (swap it into the Main Hand). In a fight, Spells and
      consumables only work from here. --}}
<fieldset class="carl-hotlist">
  <legend>
    {{localize "CARLRPG.Hotlist.Title"}} <span class="carl-hotlist-count">{{hotlist.used}}/{{hotlist.size}}</span>
  </legend>
  <ol class="carl-hotlist-rows">
    {{#each hotlist.rows as |slot|}}
    <li class="carl-hotlist-row {{#if slot.empty}}empty{{/if}} kind-{{slot.kind}}" data-slot-type="hotlist" data-slot-key="{{slot.index}}"
      {{#if slot.itemId}}data-item-id="{{slot.itemId}}"{{/if}}>
      <span class="carl-hotlist-number">{{slot.number}}</span>
      {{#if slot.empty}}
      <button type="button" class="carl-hotlist-pick" data-action="pickHotlist">
        <span class="carl-hotlist-name carl-hint">{{localize "CARLRPG.Hotlist.Empty"}}</span>
      </button>
      {{else}}
      {{#if slot.action}}
      <button type="button" class="carl-hotlist-use" data-action="useHotlist"
        data-tooltip="{{localize (concat 'CARLRPG.Hotlist.Hint.' slot.action)}}">
      {{else}}
      <div class="carl-hotlist-use carl-hotlist-idle">
      {{/if}}
        {{#if slot.img}}<img src="{{slot.img}}" alt="" width="22" height="22" />{{/if}}
        <span class="carl-hotlist-name"{{itemTooltip (lookup @root.namedItemTooltips slot.itemId)}}>{{slot.name}}</span>
        <span class="carl-hotlist-detail">
          {{#if (eq slot.kind "spell")}}R{{slot.rank}} · {{slot.manaCost}} MP{{#if slot.active}} <i class="fas fa-bolt" data-tooltip-text="{{localize 'CARLRPG.Toggle.Active'}}"></i>{{/if}}{{/if}}
          {{#if (eq slot.kind "skill")}}R{{slot.rank}}{{/if}}
          {{#if (eq slot.kind "consumable")}}×{{slot.quantity}}{{/if}}
        </span>
        {{#if slot.cooldown}}
        <span class="carl-cooldown-chip" data-tooltip="{{localize 'CARLRPG.Cooldown.Label'}}: {{slot.cooldownText}}"><i class="fas fa-hourglass-half"></i> {{slot.cooldown}}</span>
        {{/if}}
        {{#if slot.action}}
        <span class="carl-hotlist-badge">{{localize (concat "CARLRPG.Hotlist.Action." slot.action)}}</span>
        {{else if slot.inHand}}
        <span class="carl-hotlist-badge carl-hotlist-inhand">{{localize "CARLRPG.Hotlist.InHand"}}</span>
        {{else if slot.worn}}
        <span class="carl-hotlist-badge carl-hotlist-inhand">{{localize "CARLRPG.Hotlist.Worn"}}</span>
        {{/if}}
      {{#if slot.action}}
      </button>
      {{else}}
      </div>
      {{/if}}
      <a class="item-control carl-slot-clear" data-action="clearSlot" data-tooltip-text="{{localize 'CARLRPG.Actor.ClearSlot'}}"><i class="fas fa-times"></i></a>
      {{/if}}
    </li>
    {{/each}}
  </ol>
</fieldset>
