{{!-- Health Bar: clickable slot pips set the current value directly (see
      actor-sheet.mjs's _buildHbPips / #onSetHbValue) - no raw value input,
      per the book (whole slots, not raw HP). Characters always have 10
      slots (barring item bonuses, which flow through bonusMax automatically
      - never a manually-edited base), so there's no max input either. NPCs'
      slot count is a GM judgment call with no other UI to set it (Mob/Boss
      tiers vary per Table 50), so they keep a max input. Shared by
      header.hbs and header-npc.hbs. --}}
<div class="resource flex-group-center carl-hb-resource">
  <label class="resource-label">{{localize "CARLRPG.Actor.HealthBar"}}</label>
  <div class="resource-content">
    {{#if hbPips}}
    <div class="carl-hb-pips" title="{{system.hb.value}} / {{system.hb.effectiveMax}}">
      {{#each hbPips as |pip|}}
      <span class="carl-hb-pip{{#if pip.filled}} filled{{/if}}" data-action="setHbValue" data-value="{{pip.index}}"
        style="--pip-hue: {{pip.hue}}">
        <span class="carl-hb-pip-value">{{pip.slotValue}}</span>
        <span class="carl-hb-pip-percent">{{pip.percent}}%</span>
      </span>
      {{/each}}
    </div>
    {{else}}
    <span class="carl-hb-fallback">{{system.hb.value}} / {{system.hb.effectiveMax}}</span>
    {{/if}}
    {{#if (eq actor.type "npc")}}
    <div class="carl-hb-edit flexrow flex-center flex-between">
      <label>{{localize "CARLRPG.Actor.BaseValue"}}</label>
      <input type="text" class="carl-w-tiny" name="system.hb.max" value="{{system.hb.max}}" data-dtype="Number" />
      {{#unless (eq system.hb.bonusMax 0)}}
      <span class="carl-stat-bonus" title="{{localize 'CARLRPG.Actor.BonusFromItemsSkills'}}">
        ({{numberFormat system.hb.bonusMax sign=true}} = {{system.hb.effectiveMax}})
      </span>
      {{/unless}}
    </div>
    {{else if (not (eq system.hb.bonusMax 0))}}
    <span class="carl-stat-bonus" title="{{localize 'CARLRPG.Actor.BonusFromItemsSkills'}}">
      ({{numberFormat system.hb.bonusMax sign=true}} = {{system.hb.effectiveMax}})
    </span>
    {{/if}}
  </div>
</div>
