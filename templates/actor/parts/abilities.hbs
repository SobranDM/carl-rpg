{{!-- A Character's Combat tab (relabelled "abilities" slot - actor-sheet.mjs
      TAB_LABELS_BY_TYPE): everything used in a fight on one screen - the
      Stats column, the Attack Skills and the Hotlist (p.98). Skills and
      Spells have their own tab (skills-tab.hbs). --}}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <div class="carl-abilities-layout">
    {{> "systems/carl-rpg/templates/actor/parts/stats-column.hbs"}}

    <div class="carl-abilities-main">
      {{!-- Attack Skills don't need to be in the Hotlist; the printed sheet's
            front page lists them under "Attacks". --}}
      {{#if attackSkills.length}}
      <fieldset class="carl-combat-attacks">
        <legend>{{localize "CARLRPG.Tab.Attacks"}}</legend>
        <ol class="items-list">
          {{#each attackSkills as |skill|}}
          <li class="item flexrow" data-item-id="{{skill._id}}">
            <div class="item-name">
              <div class="item-image">
                <a class="rollable" data-action="roll" data-roll-type="item">
                  <img src="{{skill.img}}" title="{{skill.name}}" width="24" height="24" />
                </a>
              </div>
              <h4>{{skill.name}}</h4>
            </div>
            <div class="item-prop">{{localize "CARLRPG.Ranked.Rank"}} {{skill.system.rank}}</div>
            <div class="item-controls">
              <a class="item-control" data-action="roll" data-roll-type="item" title="{{localize 'CARLRPG.Hotlist.Attack'}}"><i class="fas fa-dice-d20"></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
      </fieldset>
      {{/if}}

      {{> "systems/carl-rpg/templates/actor/parts/hotlist.hbs"}}
    </div>
  </div>
</section>
