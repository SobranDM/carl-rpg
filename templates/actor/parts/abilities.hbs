{{!-- A Character's Combat tab (relabelled "abilities" slot - actor-sheet.mjs
      TAB_LABELS_BY_TYPE): everything used in a fight on one screen - the
      Stats column with the Attack! button (pick an Attack Skill the crawler
      can use now - CarlDice.chooseAttack), the Defenses and the Hotlist
      (p.98). Skills and Spells have their own tab (skills-tab.hbs). --}}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <div class="carl-abilities-layout">
    {{> "systems/carl-rpg/templates/actor/parts/stats-column.hbs"}}

    <div class="carl-abilities-main">
      {{!-- Defenses used every round: the Evade roll
            (DEX Mod + Evade bonuses, shown as +N), then DR, which shows its
            effective value when items or Buffs add to the editable base;
            Move and Step are plain values. Resistances come from the Race,
            Class, gear and Buffs - the button lists them, read-only. --}}
      <fieldset class="carl-combat-defenses">
        <legend>{{localize "CARLRPG.Actor.Defenses"}}</legend>
        <div class="carl-defenses-row">
          <button type="button" class="carl-evade-button" data-action="rollEvade" title="{{localize 'CARLRPG.Actor.EvadeTotalHint'}}">
            <i class="fas fa-shield-alt"></i> {{localize "CARLRPG.Roll.Evade"}}
            <span class="carl-evade-total">{{numberFormat evadeTotal sign=true}}</span>
          </button>
          <label class="carl-defense-field">
            <span class="resource-label" title="{{localize 'CARLRPG.Actor.Dr'}}">{{localize "CARLRPG.Actor.DrShort"}}</span>
            <input type="text" class="carl-w-tiny" name="system.dr" value="{{system.dr}}" data-dtype="Number"
              title="{{localize 'CARLRPG.Actor.BaseValue'}}" />
            {{#if system.drBonus}}
            <span class="carl-stat-value" title="{{localize 'CARLRPG.Actor.EffectiveValue'}}">= {{system.drEffective}}</span>
            {{/if}}
          </label>
          <label class="carl-defense-field">
            <span class="resource-label">{{localize "CARLRPG.Actor.Move"}}</span>
            <input type="text" class="carl-w-tiny" name="system.details.move" value="{{system.details.move}}" data-dtype="Number" />
          </label>
          <label class="carl-defense-field">
            <span class="resource-label">{{localize "CARLRPG.Actor.Step"}}</span>
            <input type="text" class="carl-w-tiny" name="system.details.step" value="{{system.details.step}}" data-dtype="Number" />
          </label>
          <button type="button" class="carl-resistances-button" data-action="showResistances">
            {{localize "CARLRPG.Actor.Resistances"}}
            <span class="carl-resistances-summary">{{#if resistanceSummary}}{{resistanceSummary}}{{else}}{{localize "CARLRPG.Actor.ResistNone"}}{{/if}}</span>
          </button>
        </div>
      </fieldset>

      {{> "systems/carl-rpg/templates/actor/parts/hotlist.hbs"}}
    </div>
  </div>
</section>
