{{!-- A Character's Combat tab (relabelled "abilities" slot - actor-sheet.mjs
      TAB_LABELS_BY_TYPE): everything used in a fight on one screen - the
      Stats column with the Attack! button (pick an Attack Skill the crawler
      can use now - CarlDice.chooseAttack), the Defenses and the Hotlist
      (p.98). Skills and Spells have their own tab (skills-tab.hbs). --}}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <div class="carl-abilities-layout">
    {{> "systems/carl-rpg/templates/actor/parts/stats-column.hbs"}}

    <div class="carl-abilities-main">
      {{!-- Defenses used every round: the Evade roll (DEX Mod + Evade
            bonuses, shown as +N, then any dice such as +1d4), then DR - only
            what the Race, Class, gear and Buffs give (a crawler's base DR is
            0, character.mjs) - and Move and Step, each an editable base that
            shows "= N" when items or Buffs change it. Hovering names the
            sources (bonus-sources.mjs).
            A Move or Step a Debuff blocks (Held...) is struck through.
            Resistances come from the Race, Class, gear and Buffs - the button
            lists them, read-only. --}}
      <fieldset class="carl-combat-defenses">
        <legend>{{localize "CARLRPG.Actor.Defenses"}}</legend>
        <div class="carl-defenses-row">
          <button type="button" class="carl-evade-button" data-action="rollEvade"
            data-tooltip-text="{{localize 'CARLRPG.Actor.EvadeTotalHint'}}&#10;{{defenses.evade.tooltip}}">
            <i class="fas fa-shield-alt"></i> {{localize "CARLRPG.Roll.Evade"}}
            <span class="carl-evade-total">{{numberFormat evadeTotal sign=true}}{{defenses.evade.dice}}</span>
          </button>
          <label class="carl-defense-field" data-tooltip-text="{{defenses.dr.tooltip}}">
            <span class="resource-label">{{localize "CARLRPG.Actor.DrShort"}}</span>
            <span class="carl-stat-value carl-dr-value">{{system.drEffective}}</span>
          </label>
          <label class="carl-defense-field{{#if defenses.move.blocked}} carl-defense-blocked{{/if}}" data-tooltip-text="{{defenses.move.tooltip}}">
            <span class="resource-label">{{localize "CARLRPG.Actor.Move"}}</span>
            <input type="text" class="carl-w-tiny" name="system.details.move" value="{{system.details.move}}" data-dtype="Number" />
            {{#if defenses.move.shown}}
            <span class="carl-stat-value">= {{system.moveEffective}} ft</span>
            {{/if}}
          </label>
          <label class="carl-defense-field{{#if defenses.step.blocked}} carl-defense-blocked{{/if}}" data-tooltip-text="{{defenses.step.tooltip}}">
            <span class="resource-label">{{localize "CARLRPG.Actor.Step"}}</span>
            <input type="text" class="carl-w-tiny" name="system.details.step" value="{{system.details.step}}" data-dtype="Number" />
            {{#if defenses.step.shown}}
            <span class="carl-stat-value">= {{system.stepEffective}} ft</span>
            {{/if}}
          </label>
          <button type="button" class="carl-resistances-button" data-action="showResistances">
            {{localize "CARLRPG.Actor.Resistances"}}
            <span class="carl-resistances-summary">{{#if resistanceSummary}}{{resistanceSummary}}{{else}}{{localize "CARLRPG.Actor.ResistNone"}}{{/if}}</span>
          </button>
        </div>
      </fieldset>

      {{> "systems/carl-rpg/templates/actor/parts/hotlist.hbs"}}
    </div>
  </div>
</section>
