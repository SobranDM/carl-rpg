{{!-- Spells list body - the content of the Spells drawer on the merged
      Abilities tab (see abilities.hbs / collapsible-section.hbs). --}}
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name carl-sort-header" data-action="sortList" data-list="spells" data-sort-key="name">{{localize "Name"}} <i class="fas {{@root.listSort.spells.name}}"></i></div>
    <div class="item-prop carl-sort-header" data-action="sortList" data-list="spells" data-sort-key="manaCost">{{localize "CARLRPG.Spell.ManaCost"}} <i class="fas {{@root.listSort.spells.manaCost}}"></i></div>
    <div class="item-prop carl-sort-header" data-action="sortList" data-list="spells" data-sort-key="rank">{{localize "CARLRPG.Ranked.Rank"}} <i class="fas {{@root.listSort.spells.rank}}"></i></div>
    <div class="item-controls">
      <a class="item-control item-create" data-action="createItem" data-type="spell">
        <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type="Spell"}}
      </a>
    </div>
  </li>
  {{#each spells as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <div class="item-image">
        <a class="rollable" data-action="roll" data-roll-type="item">
          <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
        </a>
      </div>
      <a class="carl-item-name-toggle" data-action="toggleDrawer" data-scope="item" data-path="system.detailsExpanded"
        title="{{localize 'CARLRPG.Ranked.ToggleDetails'}}">
        <h4>{{item.name}}{{#if item.system.active}} <i class="fas fa-bolt carl-spell-active-indicator" title="{{localize 'CARLRPG.Toggle.Active'}}"></i>{{/if}}</h4>
      </a>
    </div>
    <div class="item-prop">{{item.system.manaCost}}</div>
    <div class="item-prop">{{item.system.rank}}</div>
    <div class="item-controls">
      {{#if ../locked}}
      <a class="item-control" data-action="toggleMark" title="{{localize 'CARLRPG.Ranked.ToggleMark'}}">
        <i class="fas {{#if item.system.marked}}fa-check-square{{else}}fa-square{{/if}}"></i>
      </a>
      {{else}}
      <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Spell'}}">
        <i class="fas fa-edit"></i>
      </a>
      <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Spell'}}">
        <i class="fas fa-trash"></i>
      </a>
      {{/if}}
    </div>
  </li>
  {{!-- Always rendered, same as the Skill details drawer, so the Edit
        button is reachable while locked. --}}
  <li class="carl-nested-drawer{{#unless item.system.detailsExpanded}} collapsed{{/unless}}">
    <div class="carl-skill-details">
      <div class="carl-skill-details-inner">
        {{#if item.system.description}}
        <div class="carl-skill-description">{{{item.system.description}}}</div>
        {{/if}}
        {{#each item.system.upgrades as |upgrade|}}
        <div class="carl-skill-upgrade">
          <strong>{{localize "CARLRPG.Ranked.Rank"}} {{upgrade.rankThreshold}}</strong>
          {{#if upgrade.description}}<span>{{upgrade.description}}</span>{{/if}}
        </div>
        {{/each}}
        <a class="carl-skill-edit" data-action="editItem" data-item-id="{{item._id}}" title="{{localize 'DOCUMENT.Update' type='Spell'}}">
          <i class="fas fa-edit"></i> {{localize "CARLRPG.Spell.EditDetails"}}
        </a>
      </div>
    </div>
  </li>
  {{/each}}
</ol>
