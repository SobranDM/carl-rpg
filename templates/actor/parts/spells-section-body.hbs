{{!-- Spells list body - the content of the Spells drawer on the merged
      Abilities tab (see abilities.hbs / collapsible-section.hbs). --}}
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "Name"}}</div>
    <div class="item-prop">{{localize "CARLRPG.Spell.ManaCost"}}</div>
    <div class="item-prop">{{localize "CARLRPG.Ranked.Rank"}}</div>
    <div class="item-controls">
      <a class="item-control item-create" data-action="createItem" data-type="spell">
        <i class="fas fa-plus"></i> {{localize "DOCUMENT.New" type="Spell"}}
      </a>
    </div>
  </li>
  {{#each spells as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <div class="item-image">
        <a class="rollable" data-action="roll" data-roll-type="item">
          <img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
        </a>
      </div>
      <h4>{{item.name}}{{#if item.system.active}} <i class="fas fa-bolt carl-spell-active-indicator" title="{{localize 'CARLRPG.Toggle.Active'}}"></i>{{/if}}</h4>
    </div>
    <div class="item-prop">{{item.system.manaCost}}</div>
    <div class="item-prop">{{item.system.rank}}</div>
    <div class="item-controls">
      {{#if ../locked}}
      <a class="item-control" data-action="toggleMark" title="{{localize 'CARLRPG.Ranked.ToggleMark'}}">
        <i class="fas {{#if item.system.marked}}fa-check-square{{else}}fa-square{{/if}}"></i>
      </a>
      {{else}}
      <a class="item-control item-edit" data-action="editItem" title="{{localize 'DOCUMENT.Update' type='Spell'}}">
        <i class="fas fa-edit"></i>
      </a>
      <a class="item-control item-delete" data-action="deleteItem" title="{{localize 'DOCUMENT.Delete' type='Spell'}}">
        <i class="fas fa-trash"></i>
      </a>
      {{/if}}
    </div>
  </li>
  {{/each}}
</ol>
