{{!-- Sheet Header --}}
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" height="100" width="100" />
  <div class="header-fields">
    <div class="carl-name-row flexrow">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name" /></h1>
      <div class="resource flex-group-center carl-name-row-field">
        <label for="system.attributes.level.value" class="resource-label">{{localize "CARLRPG.Actor.Level"}}</label>
        <input type="text" class="carl-w-tiny" name="system.attributes.level.value" value="{{system.attributes.level.value}}"
          data-dtype="Number" />
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label for="carl-floor-display" class="resource-label">{{localize "CARLRPG.Actor.Floor"}}</label>
        <input id="carl-floor-display" type="text" class="carl-w-tiny carl-floor-readonly" value="{{currentFloor}}" disabled />
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label class="resource-label">{{localize "CARLRPG.Actor.Class"}}</label>
        {{#if classId}}
        <a class="item carl-class-race-link" data-action="editItem" data-item-id="{{classId}}">{{className}}</a>
        {{else}}
        <span class="carl-class-race-empty">{{localize "CARLRPG.Actor.NoneSelected"}}</span>
        {{/if}}
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label class="resource-label">{{localize "CARLRPG.Actor.Race"}}</label>
        {{#if raceId}}
        <a class="item carl-class-race-link" data-action="editItem" data-item-id="{{raceId}}">{{raceName}}</a>
        {{else}}
        <span class="carl-class-race-empty">{{localize "CARLRPG.Actor.NoneSelected"}}</span>
        {{/if}}
      </div>
    </div>
    {{!-- Crawler numbers the rules track on the sheet (p.112-115, p.24, p.23). --}}
    <div class="carl-name-row flexrow carl-tracked-row">
      <div class="resource flex-group-center carl-name-row-field">
        <label for="system.aiFavor" class="resource-label" title="{{localize 'CARLRPG.Actor.AiFavorHint'}}">{{localize "CARLRPG.Actor.AiFavor"}}</label>
        <input type="text" class="carl-w-tiny" name="system.aiFavor" value="{{system.aiFavor}}" data-dtype="Number" />
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label for="system.popularity" class="resource-label">{{localize "CARLRPG.Actor.Popularity"}}</label>
        <input type="text" class="carl-w-tiny" name="system.popularity" value="{{system.popularity}}" data-dtype="Number" />
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label for="system.gold" class="resource-label">{{localize "CARLRPG.Actor.Gold"}}</label>
        <input type="text" class="carl-w-short" name="system.gold" value="{{system.gold}}" data-dtype="Number" />
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label for="system.move" class="resource-label">{{localize "CARLRPG.Actor.Move"}}</label>
        <input type="text" class="carl-w-tiny" name="system.move" value="{{system.move}}" data-dtype="Number" />
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label for="system.step" class="resource-label">{{localize "CARLRPG.Actor.Step"}}</label>
        <input type="text" class="carl-w-tiny" name="system.step" value="{{system.step}}" data-dtype="Number" />
      </div>
    </div>
    {{> "systems/carl-rpg/templates/actor/parts/hb-bar.hbs"}}
    {{> "systems/carl-rpg/templates/actor/parts/shield-bar.hbs"}}
  </div>
</header>
