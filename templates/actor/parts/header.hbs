{{!-- A Character's header: the portrait with Level and AI Favor under it;
      name, Race and Class; then the Health Bar and Mana. Size, Popularity,
      Pronouns and Crawler# are on the Details tab, Gold on the Inventory
      tab. The Floor isn't shown - it rarely changes, and it's still in the
      roll data (@floor, the GM Toolbox's world setting). --}}
<header class="sheet-header">
  <div class="carl-portrait-column">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" data-tooltip-text="{{actor.name}}" height="100" width="100" />
    <div class="carl-portrait-stats">
      <label class="carl-portrait-stat">
        <span class="resource-label">{{localize "CARLRPG.Actor.Level"}}</span>
        <input type="text" name="system.attributes.level.value" value="{{system.attributes.level.value}}" data-dtype="Number" />
      </label>
      <label class="carl-portrait-stat">
        <span class="resource-label" data-tooltip-text="{{localize 'CARLRPG.Actor.AiFavorHint'}}">{{localize "CARLRPG.Actor.AiFavor"}}</span>
        <input type="text" name="system.details.aiFavor" value="{{system.details.aiFavor}}" data-dtype="Number"
          data-tooltip-text="{{localize 'CARLRPG.Actor.AiFavorHint'}}" />
      </label>
    </div>
  </div>
  <div class="header-fields">
    <div class="carl-name-row flexrow">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name" /></h1>
      {{#if canCreateCrawler}}
      <button type="button" class="carl-create-crawler" data-action="createCrawler" data-tooltip-text="{{localize 'CARLRPG.Chargen.OpenHint'}}">
        <i class="fas fa-user-plus"></i> {{localize "CARLRPG.Chargen.Open"}}
      </button>
      {{/if}}
      <div class="resource flex-group-center carl-name-row-field">
        <label class="resource-label">{{localize "CARLRPG.Actor.Race"}}</label>
        {{#if raceId}}
        <a class="item carl-class-race-link" data-action="editItem" data-item-id="{{raceId}}">{{raceName}}</a>
        {{else}}
        <span class="carl-class-race-empty">{{localize "CARLRPG.Actor.NoneSelected"}}</span>
        {{/if}}
      </div>
      <div class="resource flex-group-center carl-name-row-field">
        <label class="resource-label">{{localize "CARLRPG.Actor.Class"}}</label>
        {{#if classId}}
        <a class="item carl-class-race-link" data-action="editItem" data-item-id="{{classId}}">{{className}}</a>
        {{else}}
        <span class="carl-class-race-empty">{{localize "CARLRPG.Actor.NoneSelected"}}</span>
        {{/if}}
      </div>
    </div>
    {{> "systems/carl-rpg/templates/actor/parts/hb-bar.hbs"}}
    {{> "systems/carl-rpg/templates/actor/parts/mana-bar.hbs"}}
    {{> "systems/carl-rpg/templates/actor/parts/shield-bar.hbs"}}
  </div>
</header>
